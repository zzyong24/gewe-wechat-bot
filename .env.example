# 微信机器人（gewe）—— 密钥类环境变量示例。全部是占位符，复制成你自己的文件后填真值：
#   sudo install -m 600 -o gewebot .env.example /etc/gewe-wechat-bot.env && sudo nano /etc/gewe-wechat-bot.env
# 格式：systemd EnvironmentFile（KEY=VALUE，一行一个；值不加引号；不支持 export、$变量展开；
#       注释只能单独占一行——写在值后面的「# xxx」会被当成值的一部分）。
# 不要 `source` 它；手动跑时的加载方法见 README「常见问题」。

# ---- 必填：gewe 控制台「令牌管理」里的 TokenId（请求头 X-GEWE-TOKEN）----
GEWE_TOKEN=your-gewe-token

# ---- 选填：大模型。不填 = 只有规则功能（成员列表、统计、游戏…），陪聊等调模型的功能不工作 ----
# 陪聊 / 识图 / 语音转写 / TTS / 生图 / 搜索都走 MiniMax
MINIMAX_API_KEY=

# ---- 选填（不填相关功能自动降级）----
# 高德 Web 服务 Key：天气 / 附近 / 路线
AMAP_KEY=
# 豆包 TTS，MiniMax TTS 失败时的备用
DOUBAO_TTS_API_KEY=
# AI 快讯接口若有 Basic Auth / digest Bearer token
AIHOT_BASIC_AUTH_PASSWORD=
AIHOT_INGEST_TOKEN=
# 可选：用 Bitwarden Secrets Manager(bws) 按名字取上面两个 AIHOT 密钥
BWS_ACCESS_TOKEN=

# ---- 路径 ----
# 存 appId 的文件（扫码登录后写入；重新登录务必沿用同一个 appId）
GEWE_APPID_FILE=/opt/gewe-wechat-bot/data/gewe_appid.txt
# 中转服务器地址 + secret（双机部署用；单机 callback_server 不需要）
RELAY_CONFIG=/opt/gewe-wechat-bot/.relay_config.json
# BOT_DATA_DIR=/opt/gewe-wechat-bot/data

# ---- 单机模式 callback_server.py 用 ----
# CALLBACK_SECRET=replace-with-a-long-random-string
# ---- 中转 relay.py 用（放在中转机自己的 /etc/gewe-relay.env）----
# RELAY_SECRET=replace-with-a-long-random-string
