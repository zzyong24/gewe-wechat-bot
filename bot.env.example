# 非密钥配置（poller 启动时自动加载 ./bot.env；已经在环境变量里的优先，不覆盖）。
#   cp bot.env.example bot.env
# 密钥绝不写这里，放 .env.example 那一份。

# ---- 发送闸（默认 dry-run：只进 outbox，不真发）----
BOT_SEND_ENABLED=0
# 真发白名单，逗号分隔的 群id@chatroom / wxid；空 = 一律不发。先放一个测试群
BOT_SEND_ALLOW=
# 每日学习读取的群（只读不发）；空则回落到 BOT_SEND_ALLOW
BOT_LEARN_ROOMS=

# ---- 身份 ----
# 机器人自己的 wxid（登录后 checkOnline / 回调里的 Wxid）
BOT_WXID=
# 主人的 wxid：改人设、静音、最高优先级指令只认他
BOT_OWNER_WXID=
# 追加的超级管理员（可改功能开关），逗号分隔
BOT_ADMIN_WXIDS=
# 别的机器人（防互相触发），逗号分隔
BOT_IGNORE_WXIDS=
# 人设文件（UTF-8 文本），空 = 用 features/chat_companion.py 里的示例人设
BOT_PERSONA_FILE=

# ---- 图床：中转服务器的公网地址（gewe 发图/语音要公网 URL）----
# BOT_IMG_PUBLIC_BASE=https://relay.example.com

# ---- AI 快讯（可选：需要一个兼容 /api/v1/timeline 的资讯接口）----
BOT_AIHOT_API=https://aihot.example.com
BOT_AIHOT_DETAIL_URL=https://aihot.example.com/
BOT_AIHOT_BRAND=AI 快讯
BOT_AIHOT_SRC_BLOCK=
BOT_AIHOT_AGG_ONLY_CAP=2

# ---- 公众号新文推群（可选）----
BOT_GZH_ID=
BOT_GZH_NAME=
BOT_GZH_X_USER=

# ---- 每日学习（可选）----
# 观察学习的别家机器人："wxid_x:昵称,wxid_y:昵称"
BOT_OBSERVE_BOTS=
# 只学风格、不写群友记忆的群
BOT_LEARN_STYLE_ONLY_ROOM=
